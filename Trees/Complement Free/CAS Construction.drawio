        <mxCell id="2bkVFfdwQwM_3sd6mGNa-2" value="Copy NAS construction with alphabet shift" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
