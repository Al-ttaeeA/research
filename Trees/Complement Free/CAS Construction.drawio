        <mxCell id="2bkVFfdwQwM_3sd6mGNa-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Construct NAS at order n-1 then lift using lempel&#39;s lift with the same implementation as NAS.c, before adding the additional cycles at the boundaries&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This makes an order n complement avoiding sequence with some missing strings&lt;/div&gt;" vertex="1">
