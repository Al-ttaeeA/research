            <Array as="points">
              <mxPoint x="430" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-6" value="Odd k" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-8" value="Even k" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-9" value="FKM with weight&amp;gt;n(k-1)/2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="230" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-10" value="Construct NAS at order n-1 then lift using lempel&#39;s lift with the same implementation as NAS.c, before adding the additional cycles at the boundaries&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This makes an order n complement avoiding sequence with some missing strings&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="320" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-13" value="Odd n" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="150" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-14" value="Even n" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="375" y="150" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-15" value="The missing strings can be added in the following ways:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="420" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-16" value="When k/2 is even, the missing strings can be grouped into groups that contain all binary strings of length n where the digits {0,1} are shifted into {i, i+k/2} where i is in 0..{k/2-1}&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;For such groups, we can add a binary DB sequence of order n after the appropriate digit shift as mentioned above&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="440" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-17" value="When k/2 is odd, the missing strings include the same groups as when k/2 is even, so they can be added like mentioned&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;But there is an extra group that contains only half of the binary strings of length n, as in this case the digits that form this group are complements of one another&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;To add these strings to the sequence we can instead add a binary complement free sequene of order n with an appropriate digit shift&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="440" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="2bkVFfdwQwM_3sd6mGNa-18" value="0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="730" y="100" width="20" height="20" as="geometry" />
        </mxCell>
