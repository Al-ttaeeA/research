        <mxCell id="qGyQn1BHhKlmSEBrY9DH-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Use FKM with weight&amp;gt;n(k-1)/2 to construct a sequence of length ((k^n)/2) - k/2&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The remaining symbols can be added in the following way:&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="290" x="650" y="320" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-3" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;entryX=0.485;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="qGyQn1BHhKlmSEBrY9DH-2" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="791" y="180" />
            </Array>
            <mxPoint x="350" y="180" as="sourcePoint" />
            <mxPoint x="860" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="n=2" vertex="1">
          <mxGeometry height="30" width="60" x="640" y="150" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="We run an insertion loop that loops k/4 times. For i = 0,1,...,k/4 -1, we insert two digits:&lt;div&gt;- insert the digit 2i in the middle of the instance where the string &quot;&amp;lt;k-1-2i&amp;gt;&amp;lt;2i+1&amp;gt;&quot; appears&lt;/div&gt;&lt;div&gt;- insert the digit 2i+1 in the middle of the instance where the string &quot;&amp;lt;k-1-2i&amp;gt;&amp;lt;k-2-2i&amp;gt;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;After iterating k/4 times we reach a maximal CAS&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="290" x="650" y="420" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="NEW UPPERBOUND:&lt;div&gt;- if k/2 is even, same upperbound applies, k^2/2&lt;/div&gt;&lt;div&gt;- if k/2 is odd, upperbound is (k^2/2)-1 since there is 1 last boundary edge that can never be added without a duplicate or breaking complement free status&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="290" x="650" y="560" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="O(1)" vertex="1">
          <mxGeometry height="50" width="60" x="30" y="130" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="O(1)" vertex="1">
          <mxGeometry height="50" width="60" x="170" y="230" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="O(1)" vertex="1">
          <mxGeometry height="240" width="60" x="170" y="320" as="geometry" />
        </mxCell>
        <mxCell id="qGyQn1BHhKlmSEBrY9DH-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="O(1) using hashmap for storing index of each appearing string WHILE constructing FKM&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;We could also use a linked list since inserting the k/2 digits to a string costs time per digit inserted&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="120" x="940" y="320" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Example for n=2, k=10" vertex="1">
          <mxGeometry height="30" width="140" x="1360" y="70" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="192829373839464748495565758596676869778798899" vertex="1">
          <mxGeometry height="30" width="330" x="1265" y="140" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Start with" vertex="1">
          <mxGeometry height="30" width="70" x="1395" y="110" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Loop iteration #1, i=0, we need to find&amp;nbsp;&lt;div&gt;&quot;91&quot; and add 0 in the middle&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="230" x="1315" y="180" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="192829373839464748495565758596676869778798899&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;0&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="330" x="1265" y="220" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Loop iteration #1, then we need to&amp;nbsp;&lt;div&gt;find &quot;98&quot; and add 1 in the middle&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="210" x="1325" y="260" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="19282937383946474849556575859667686977879&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;1&lt;/font&gt;8899&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;0&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="330" x="1265" y="310" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Loop iteration #2, i=1, we need to find&amp;nbsp;&lt;div&gt;&quot;73&quot; and add 2 in the middle&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="230" x="1315" y="360" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="19282937&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;2&lt;/font&gt;383946474849556575859667686977879&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;1&lt;/font&gt;8899&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;0&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="330" x="1265" y="400" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Loop iteration #2, then we need to&amp;nbsp;&lt;div&gt;find &quot;76&quot; and add 3 in the middle&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="210" x="1325" y="440" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="19282937&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;2&lt;/font&gt;383946474849556575859667&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;3&lt;/font&gt;686977879&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;1&lt;/font&gt;8899&lt;font style=&quot;color: rgb(255, 17, 17);&quot;&gt;0&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="330" x="1265" y="490" as="geometry" />
        </mxCell>
        <mxCell id="MsSkpVvFn-mNZoWK_bTs-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="The last complementary pair that cannot be added is 45/54&lt;div&gt;Thus this sequence is maximal&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="340" x="1260" y="530" as="geometry" />
        </mxCell>
      </root>
